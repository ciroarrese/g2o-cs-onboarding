{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": [],
    "paths": {
      "video-estudio/*": ["/home/user/video-estudio/*"],
      "react": ["/home/user/video-estudio/node_modules/@types/react"],
      "react/jsx-runtime": ["/home/user/video-estudio/node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": ["migracion/**/*.ts", "migracion/**/*.tsx"]
}
